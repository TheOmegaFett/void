{
  "source": {
    "include": ["src"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(^|/|\\\\)_"
  },
  "plugins": ["plugins/markdown"],
  "opts": {
    "destination": "docs/api",
    "recurse": true,
    "readme": "README.md",
    "tutorials": "docs/tutorials"
  },
  "templates": {
    "default": {
      "outputSourceFiles": true
    }
  }
}

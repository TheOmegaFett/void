{
  "name": "void-flow-wowplus",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:junit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --reporters=default --reporters=jest-junit",
    "lint": "eslint .",
    "docs:clean": "rm -rf docs/api",
    "docs:generate": "npm run docs:clean && jsdoc -c jsdoc.config.json"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^9.8.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jsdoc": "^4.0.5",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
